{
  "name": "gmai_pulse_coverme_daily",
  "tags": {
    "project": "gmai-pulse",
    "domain": "coverme"
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "parameters": [
    {"name": "target_catalog", "default": "usdo_aa_catalog"},
    {"name": "mode", "default": "incremental"},
    {"name": "start_date", "default": "2023-02-28"},
    {"name": "repo_root", "default": ""},
    {"name": "pseudonymize", "default": "false"}
  ],
  "job_clusters": [
    {
      "job_cluster_key": "gmai_pulse_cluster",
      "new_cluster": {
        "spark_version": "__DBR_SPARK_VERSION__",
        "node_type_id": "__NODE_TYPE_ID__",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "custom_tags": {"project": "gmai-pulse"}
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/Toronto",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": ["__ALERT_EMAIL__"]
  },
  "tasks": [
    {
      "task_key": "freshness_guard",
      "job_cluster_key": "gmai_pulse_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/__GIT_FOLDER_OWNER__/GMAI-PULSE-DATABRICKS/databricks/src/cm_00_freshness_guard",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 900000
    },
    {
      "task_key": "bronze",
      "depends_on": [{"task_key": "freshness_guard"}],
      "job_cluster_key": "gmai_pulse_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/__GIT_FOLDER_OWNER__/GMAI-PULSE-DATABRICKS/databricks/src/cm_01_bronze_ingest",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 900000
    },
    {
      "task_key": "silver",
      "depends_on": [{"task_key": "bronze"}],
      "job_cluster_key": "gmai_pulse_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/__GIT_FOLDER_OWNER__/GMAI-PULSE-DATABRICKS/databricks/src/cm_02_silver_conform",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 900000
    },
    {
      "task_key": "gold",
      "depends_on": [{"task_key": "silver"}],
      "job_cluster_key": "gmai_pulse_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/__GIT_FOLDER_OWNER__/GMAI-PULSE-DATABRICKS/databricks/src/cm_03_gold_kpis",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 900000
    }
  ]
}
